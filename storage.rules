rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /perfiles/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Imágenes de galería de microscopía (lectura pública, escritura solo docente)
    match /lab_images/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.auth.token.firebase.sign_in_provider == 'password'
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Fotos de prácticas de laboratorio
    // Escritura: auth anónima o con contraseña (estudiantes usando la página de captura)
    // Lectura: solo docente autenticado con email/password
    match /lab-reports/{allPaths=**} {
      allow read:  if request.auth != null
                   && request.auth.token.firebase.sign_in_provider == 'password';
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Fotos de parciales físicos (calificación asistida por IA).
    // Solo el docente/EPS sube y lee — a diferencia de lab-reports, acá nunca
    // sube el alumno directamente.
    match /parciales_fotos/{allPaths=**} {
      allow read:  if request.auth != null
                   && (request.auth.token.email == 'docente@acadvet-usam.edu.sv'
                       || request.auth.token.email == 'eps@acadvet-usam.edu.sv');
      allow write: if request.auth != null
                   && (request.auth.token.email == 'docente@acadvet-usam.edu.sv'
                       || request.auth.token.email == 'eps@acadvet-usam.edu.sv')
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
