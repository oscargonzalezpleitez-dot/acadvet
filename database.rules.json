{
  "rules": {

    "config": {
      ".read": false,
      ".write": false,
      "lab_location": {
        ".read": true,
        ".write": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')"
      }
    },

    "login_lockout": {
      ".read": false,
      ".write": false
    },

    "materias": {
      ".read":  "auth != null",
      ".write": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')",
      "$materiaId": {
        ".validate": "newData.hasChildren(['nombre', 'ciclo', 'estado'])",

        "tareas_asignadas": {
          "$tareaId": {
            ".write": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')",
            ".validate": "newData.hasChildren(['titulo', 'fechaLimite', 'creadaEn'])"
          }
        }
      }
    },

    "alumnos": {
      ".read":  "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')",
      ".write": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')",
      "$alumnoId": {

        "nombre": {
          ".read": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv' || (auth.token.email != null && auth.token.email == root.child('alumnos').child($alumnoId).child('email').val()))"
        },
        "carnet": {
          ".read": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv' || (auth.token.email != null && auth.token.email == root.child('alumnos').child($alumnoId).child('email').val()))"
        },

        "email": {
          ".read": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv' || (auth.token.email != null && auth.token.email == data.val()))",
          ".write": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv' || (auth.token.email != null && !data.exists() && newData.val() == auth.token.email))"
        },

        "pushTokens": {
          ".read": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv' || (auth.token.email != null && auth.token.email == root.child('alumnos').child($alumnoId).child('email').val()))",
          "$tokenKey": {
            ".write": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv' || (auth.token.email != null && auth.token.email == root.child('alumnos').child($alumnoId).child('email').val()))",
            ".validate": "newData.hasChildren(['token', 'savedAt'])"
          }
        },

        "inscripciones": {
          "$materiaId": {

            "parciales": {
              ".read": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv' || (auth.token.email != null && auth.token.email == root.child('alumnos').child($alumnoId).child('email').val()))",
              "$parcialId": {
                ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100)"
              }
            },
            "asistencias": {
              ".read": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv' || (auth.token.email != null && auth.token.email == root.child('alumnos').child($alumnoId).child('email').val()))",
              "$asistId": {
                ".validate": "newData.hasChildren(['fecha', 'estado'])"
              }
            },
            "quizzes": {
              ".read": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv' || (auth.token.email != null && auth.token.email == root.child('alumnos').child($alumnoId).child('email').val()))"
            },
            "exposiciones": {
              ".read": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv' || (auth.token.email != null && auth.token.email == root.child('alumnos').child($alumnoId).child('email').val()))"
            },
            "nota_diagnostico": {
              ".read": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv' || (auth.token.email != null && auth.token.email == root.child('alumnos').child($alumnoId).child('email').val()))"
            },
            "tareas": {
              ".read": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv' || (auth.token.email != null && auth.token.email == root.child('alumnos').child($alumnoId).child('email').val()))",
              ".write": "auth != null",
              "$tareaId": {
                ".write": "auth != null && !data.exists()",
                ".validate": "newData.hasChildren(['nombre', 'subidoEn'])"
              }
            }
          }
        }
      }
    },

    "alumno_observaciones": {
      ".read":  "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')",
      ".write": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')",
      "$alumnoId": {
        "$materiaId": {
          ".validate": "newData.isString()"
        }
      }
    },

    "alumno_lookup": {
      ".read": true,
      ".write": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')",
      "$carnetKey": {
        ".validate": "newData.hasChildren(['alumnoId', 'nombre'])"
      }
    },

    "qr_sessions": {
      ".read":  "auth != null",
      "$sessionId": {
        ".write": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')",
        "asistentes": {
          "$asistenteId": {
            ".write":    "auth != null && !data.exists()",
            ".validate": "newData.hasChildren(['nombre', 'carnet', 'ts'])"
          }
        }
      }
    },

    "grupos_sorteos": {
      ".read":  "auth != null",
      ".write": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')",
      "$sorteoId": {
        ".validate": "newData.hasChildren(['materiaId', 'tamano', 'grupos', 'estado'])"
      }
    },

    "solicitudes_idx": {
      ".read": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')",
      "$carnetKey": {
        ".write": "auth != null && ((auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv') || !data.exists())",
        ".validate": "newData.isBoolean()"
      }
    },

    "solicitudes_registro": {
      ".read":  "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')",
      ".write": "auth != null",
      "$solicitudId": {
        ".validate": "newData.hasChildren(['nombre', 'carnet', 'email', 'materias'])",
        "nombre":   { ".validate": "newData.isString() && newData.val().length <= 200" },
        "carnet":   { ".validate": "newData.isString() && newData.val().length <= 40" },
        "email":    { ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 120)" },
        "telefono": { ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 40)" },
        "fotoB64":  { ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 400000)" }
      }
    },

    "cuestionarios": {
      ".read":  "auth != null",
      ".write": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')",
      "$quizId": {
        ".validate": "newData.hasChildren(['nombre', 'tiempo', 'activo'])"
      }
    },

    "cuestionarios_correctas": {
      ".read":  "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')",
      ".write": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')"
    },

    "cuestionarios_enviados": {
      ".read":  "auth != null",
      ".write": "auth != null",
      "$quizId": {
        "$carnetKey": {
          ".validate": "!data.exists() && newData.isNumber()"
        }
      }
    },

    "cuestionarios_resultados": {
      ".read":  "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')",
      ".write": "auth != null",
      "$resultId": {
        ".validate": "newData.hasChildren(['cuestionarioId', 'alumno']) && !data.exists()"
      }
    },

    "lab_reports": {
      ".read":  "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')",
      ".write": "auth != null",
      "$reportId": {
        ".validate": "newData.hasChildren(['student_name', 'student_id', 'tipo_preparacion', 'timestamp', 'foto_url'])"
      }
    },

    "lab_images": {
      ".read":  true,
      ".write": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')"
    },

    "reminders": {
      ".read":  true,
      ".write": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')"
    },

    "presencia_alumnos": {
      ".read": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')",
      "$alumnoId": {
        ".write": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv' || auth.token.email == root.child('alumnos').child($alumnoId).child('email').val())",
        ".validate": "newData.hasChildren(['nombre', 'carnet', 'desde'])"
      }
    },

    "parciales_claves": {
      ".read":  "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')",
      ".write": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')",
      "$materiaId": {
        "$parcialId": {
          "$version": {
            ".validate": "newData.hasChildren(['respuestas', 'numPreguntas'])"
          }
        }
      }
    },

    "parciales_rubricas": {
      ".read":  "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')",
      ".write": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')",
      "$materiaId": {
        "$parcialId": {
          ".validate": "newData.hasChildren(['texto'])"
        }
      }
    },

    "parciales_revision": {
      ".read":  "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')",
      ".write": "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')",
      "$materiaId": {
        "$parcialId": {
          "$alumnoId": {
            ".validate": "newData.hasChildren(['fotos', 'estado'])"
          }
        }
      }
    },

    "student_competencies": {
      ".read":  "auth != null && (auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv')",
      "$studentKey": {
        ".read":  "auth != null",
        "$compId": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['student_id', 'student_name', 'comp_id', 'comp_name', 'status']) && ((auth.token.email == 'docente@acadvet-usam.edu.sv' || auth.token.email == 'eps@acadvet-usam.edu.sv') || (newData.child('status').val() === 'pendiente' && !newData.child('validated_by').exists() && !newData.child('validated_at').exists()))"
        }
      }
    }

  }
}
