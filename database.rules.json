{
  "rules": {

    "config": {
      ".read": false,
      ".write": false,
      "lab_location": {
        ".read": true,
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true)"
      },
      "informe_email_default": {
        ".read":  "auth != null && (root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true)"
      }
    },

    "login_lockout": {
      ".read": false,
      ".write": false
    },

    "materias": {
      ".read":  "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      "$materiaId": {
        ".validate": "newData.hasChildren(['nombre', 'ciclo', 'estado'])",

        "tareas_asignadas": {
          "$tareaId": {
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true)",
            ".validate": "newData.hasChildren(['titulo', 'fechaLimite', 'creadaEn'])"
          }
        }
      }
    },

    "alumnos": {
      ".read":  "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      "$alumnoId": {

        "nombre": {
          ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email != null && auth.token.email == root.child('alumnos').child($alumnoId).child('email').val()))"
        },
        "carnet": {
          ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email != null && auth.token.email == root.child('alumnos').child($alumnoId).child('email').val()))"
        },

        "email": {
          ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email != null && auth.token.email == data.val()))",
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email != null && auth.token.email_verified == true && !data.exists() && newData.val() == auth.token.email))"
        },

        "pushTokens": {
          ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email != null && auth.token.email == root.child('alumnos').child($alumnoId).child('email').val()))",
          "$tokenKey": {
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email != null && auth.token.email == root.child('alumnos').child($alumnoId).child('email').val()))",
            ".validate": "newData.hasChildren(['token', 'savedAt'])"
          }
        },

        "inscripciones": {
          "$materiaId": {

            "parciales": {
              ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email != null && auth.token.email == root.child('alumnos').child($alumnoId).child('email').val()))",
              "$parcialId": {
                ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100)"
              }
            },
            "asistencias": {
              ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email != null && auth.token.email == root.child('alumnos').child($alumnoId).child('email').val()))",
              "$asistId": {
                ".validate": "newData.hasChildren(['fecha', 'estado'])"
              }
            },
            "quizzes": {
              ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email != null && auth.token.email == root.child('alumnos').child($alumnoId).child('email').val()))"
            },
            "exposiciones": {
              ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email != null && auth.token.email == root.child('alumnos').child($alumnoId).child('email').val()))"
            },
            "nota_diagnostico": {
              ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email != null && auth.token.email == root.child('alumnos').child($alumnoId).child('email').val()))"
            },
            "tareas": {
              ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email != null && auth.token.email == root.child('alumnos').child($alumnoId).child('email').val()))",
              "$tareaId": {
                ".write": "auth != null && (!data.exists() || root.child('admins').child(auth.uid).val() === true)",
                ".validate": "newData.hasChildren(['nombre', 'subidoEn'])"
              }
            }
          }
        }
      }
    },

    "alumno_observaciones": {
      ".read":  "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      "$alumnoId": {
        "$materiaId": {
          ".validate": "newData.isString()"
        }
      }
    },

    "alumno_lookup": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      "$carnetKey": {
        ".validate": "newData.hasChildren(['alumnoId', 'nombre'])"
      }
    },

    "qr_sessions": {
      ".read":  "auth != null",
      "$sessionId": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true)",
        "asistentes": {
          "$asistenteId": {
            ".write":    "auth != null && (!data.exists() || root.child('admins').child(auth.uid).val() === true)",
            ".validate": "newData.hasChildren(['nombre', 'carnet', 'ts']) && ((root.child('admins').child(auth.uid).val() === true) || (root.child('qr_sessions').child($sessionId).child('active').val() === true && newData.child('ts').val() <= (now + 120000) && (newData.child('token').val() == root.child('qr_sessions').child($sessionId).child('token').val() || (root.child('qr_sessions').child($sessionId).child('prevToken').exists() && newData.child('token').val() == root.child('qr_sessions').child($sessionId).child('prevToken').val() && now <= root.child('qr_sessions').child($sessionId).child('prevTokenExpiresAt').val()))))"
          }
        }
      }
    },

    "grupos_sorteos": {
      ".read":  "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      "$sorteoId": {
        ".validate": "newData.hasChildren(['materiaId', 'tamano', 'grupos', 'estado'])"
      }
    },

    "solicitudes_idx": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      "$carnetKey": {
        ".write": "auth != null && ((root.child('admins').child(auth.uid).val() === true) || !data.exists())",
        ".validate": "newData.isBoolean()"
      }
    },

    "solicitudes_registro": {
      ".read":  "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      "$solicitudId": {
        ".write":    "auth != null && ((root.child('admins').child(auth.uid).val() === true) || !data.exists())",
        ".validate": "newData.hasChildren(['nombre', 'carnet', 'email', 'materias'])",
        "nombre":   { ".validate": "newData.isString() && newData.val().length <= 200" },
        "carnet":   { ".validate": "newData.isString() && newData.val().length <= 40" },
        "email":    { ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 120)" },
        "telefono": { ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 40)" },
        "fotoB64":  { ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 400000)" }
      }
    },

    "cuestionarios": {
      ".read":  "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      "$quizId": {
        ".validate": "newData.hasChildren(['nombre', 'tiempo', 'activo'])"
      }
    },

    "cuestionarios_correctas": {
      ".read":  "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true)"
    },

    "cuestionarios_enviados": {
      ".read":  "auth != null",
      "$quizId": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true)",
        "$carnetKey": {
          ".write":    "auth != null && !data.exists()",
          ".validate": "newData.isNumber()"
        }
      }
    },

    "cuestionarios_resultados": {
      ".read":  "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      "$resultId": {
        ".write":    "auth != null && ((root.child('admins').child(auth.uid).val() === true) || !data.exists())",
        ".validate": "newData.hasChildren(['cuestionarioId', 'alumno'])"
      }
    },

    "informes_semanales": {
      ".read":  "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      "$informeId": {
        ".validate": "newData.hasChildren(['materiaId', 'semanaInicio', 'semanaFin', 'criterios'])"
      }
    },

    "lab_report_templates": {
      ".read":  "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      "$templateId": {
        ".validate": "newData.hasChildren(['nombre', 'activo', 'secciones'])"
      }
    },

    "lab_report_submissions": {
      ".read":  "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      "$subId": {
        ".write":    "auth != null && ((root.child('admins').child(auth.uid).val() === true) || !data.exists())",
        ".validate": "newData.hasChildren(['templateId', 'alumno'])"
      }
    },

    "lab_reports": {
      ".read":  "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      "$reportId": {
        ".write":    "auth != null && ((root.child('admins').child(auth.uid).val() === true) || !data.exists())",
        ".validate": "newData.hasChildren(['student_name', 'student_id', 'tipo_preparacion', 'timestamp', 'foto_url'])"
      }
    },

    "lab_images": {
      ".read":  true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true)"
    },

    "reminders": {
      ".read":  true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true)"
    },

    "presencia_alumnos": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      "$alumnoId": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email != null && auth.token.email == root.child('alumnos').child($alumnoId).child('email').val()))",
        ".validate": "newData.hasChildren(['nombre', 'carnet', 'desde'])"
      }
    },

    "parciales_claves": {
      ".read":  "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      "$materiaId": {
        "$parcialId": {
          "$version": {
            ".validate": "newData.hasChildren(['respuestas', 'numPreguntas'])"
          }
        }
      }
    },

    "parciales_borrador": {
      ".read":  "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true)"
    },

    "parciales_rubricas": {
      ".read":  "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      "$materiaId": {
        "$parcialId": {
          ".validate": "newData.hasChildren(['texto'])"
        }
      }
    },

    "parciales_revision": {
      ".read":  "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      "$materiaId": {
        "$parcialId": {
          "$alumnoId": {
            ".validate": "newData.hasChildren(['fotos', 'estado'])"
          }
        }
      }
    },

    "student_competencies": {
      ".read":  "auth != null && (root.child('admins').child(auth.uid).val() === true)",
      "$studentKey": {
        ".read":  "auth != null",
        "$compId": {
          ".write": "auth != null && (newData.exists() || root.child('admins').child(auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['student_id', 'student_name', 'comp_id', 'comp_name', 'status']) && ((root.child('admins').child(auth.uid).val() === true) || ((!data.exists() || data.child('status').val() === 'pendiente') && newData.child('status').val() === 'pendiente' && !newData.child('validated_by').exists() && !newData.child('validated_at').exists()))"
        }
      }
    }

  }
}
